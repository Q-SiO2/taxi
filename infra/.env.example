POSTGRES_DB=taximobile
POSTGRES_USER=taximobile
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432
TAXIMOBILE_PROCESS_ROLE=all
API_PORT=8000
TAXIMOBILE_JWT_SECRET=replace-with-at-least-32-random-local-only-characters
TAXIMOBILE_MATCHING_RADIUS_METERS=3000
TAXIMOBILE_MATCHING_LOCATION_FRESHNESS_SECONDS=30
TAXIMOBILE_MATCHING_CANDIDATE_LIMIT=10
TAXIMOBILE_MATCHING_IDLE_CAP_SECONDS=1800
TAXIMOBILE_MATCHING_FAIRNESS_LOOKBACK_HOURS=24
TAXIMOBILE_MATCHING_ASSUMED_PICKUP_SPEED_MPS=6.944
TAXIMOBILE_MATCHING_PROXIMITY_WEIGHT=0.55
TAXIMOBILE_MATCHING_IDLE_WEIGHT=0.30
TAXIMOBILE_MATCHING_FAIRNESS_WEIGHT=0.15
TAXIMOBILE_MATCHING_ALGORITHM_VERSION=mvp-v1
TAXIMOBILE_MATCHING_POLL_SECONDS=1
TAXIMOBILE_CREDENTIAL_POLL_SECONDS=60
TAXIMOBILE_CREDENTIAL_EXPIRY_WARNING_DAYS=30
TAXIMOBILE_MATCHING_TIMEOUT_SECONDS=300
TAXIMOBILE_RIDE_OFFER_SECONDS=45
TAXIMOBILE_ROUTING_PROVIDER=valhalla
TAXIMOBILE_ROUTING_BASE_URL=http://valhalla:8002
TAXIMOBILE_ROUTING_TIMEOUT_SECONDS=5
TAXIMOBILE_ROUTING_RATE_LIMIT_PER_MINUTE=30
# Used only by an explicit local routing selection; inputs must remain dated and immutable.
VALHALLA_TILE_URL=https://download.geofabrik.de/africa/morocco-260819.osm.pbf
VALHALLA_SERVER_THREADS=2
# GraphHopper verifies this exact dated extract before building its digest-namespaced graph.
GRAPHHOPPER_OSM_URL=https://download.geofabrik.de/africa/morocco-260819.osm.pbf
GRAPHHOPPER_OSM_SHA256=65bce3352be7444193110ef5f6ae03746a715f843ac8cb215416f637c08b0028
# Leave empty for WebSocket-only local development. Production uses ADC/workload identity.
TAXIMOBILE_FIREBASE_PROJECT_ID=
TAXIMOBILE_FCM_TIMEOUT_SECONDS=5
# Dedicated 32+ character bearer token for the private per-instance metrics scrape.
TAXIMOBILE_MONITORING_TOKEN=
TAXIMOBILE_OUTBOX_POLL_SECONDS=1
TAXIMOBILE_OUTBOX_MAX_ATTEMPTS=8
# Abuse protections; tune staging/production values without changing source.
TAXIMOBILE_REGISTRATION_RATE_LIMIT_PER_MINUTE=5
TAXIMOBILE_LOGIN_RATE_LIMIT_PER_MINUTE=5
TAXIMOBILE_RIDE_CREATION_RATE_LIMIT_PER_MINUTE=5
TAXIMOBILE_SUPPORT_TICKET_RATE_LIMIT_PER_MINUTE=5
TAXIMOBILE_LOCATION_UPDATE_RATE_LIMIT_PER_MINUTE=60
TAXIMOBILE_VERIFICATION_SUBMISSION_RATE_LIMIT_PER_HOUR=5
TAXIMOBILE_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated browser origins. Leave empty for native-mobile-only local development.
TAXIMOBILE_CORS_ORIGINS=
