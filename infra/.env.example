POSTGRES_DB=taximobile
POSTGRES_USER=taximobile
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432
# Per API/worker process. Size + overflow multiplied by replica count must fit
# inside the managed PostgreSQL connection budget with migration/operations reserve.
TAXIMOBILE_DATABASE_POOL_SIZE=5
TAXIMOBILE_DATABASE_POOL_MAX_OVERFLOW=10
TAXIMOBILE_DATABASE_POOL_TIMEOUT_SECONDS=30
# Migration process only: nonzero per-lock/per-statement bounds, in seconds.
TAXIMOBILE_MIGRATION_LOCK_TIMEOUT_SECONDS=5
TAXIMOBILE_MIGRATION_STATEMENT_TIMEOUT_SECONDS=300
TAXIMOBILE_PROCESS_ROLE=all
API_PORT=8000
TAXIMOBILE_JWT_SECRET=replace-with-at-least-32-random-local-only-characters
# Closed build identity is optional only in local development. Staging and
# production force it on. Raise minimums only after the replacement artifacts,
# user communication, rollback plan, and intentionally obsolete-client test.
TAXIMOBILE_CLIENT_COMPATIBILITY_ENFORCED=false
TAXIMOBILE_CLIENT_POLICY_REVISION=baseline-1
TAXIMOBILE_CLIENT_ANDROID_PASSENGER_MINIMUM_VERSION=1.0.0
TAXIMOBILE_CLIENT_ANDROID_PASSENGER_RECOMMENDED_VERSION=1.0.0
TAXIMOBILE_CLIENT_ANDROID_DRIVER_MINIMUM_VERSION=1.0.0
TAXIMOBILE_CLIENT_ANDROID_DRIVER_RECOMMENDED_VERSION=1.0.0
TAXIMOBILE_CLIENT_IOS_PASSENGER_MINIMUM_VERSION=1.0.0
TAXIMOBILE_CLIENT_IOS_PASSENGER_RECOMMENDED_VERSION=1.0.0
TAXIMOBILE_CLIENT_IOS_DRIVER_MINIMUM_VERSION=1.0.0
TAXIMOBILE_CLIENT_IOS_DRIVER_RECOMMENDED_VERSION=1.0.0
TAXIMOBILE_CLIENT_WEB_APPLICANT_MINIMUM_VERSION=1.0.0
TAXIMOBILE_CLIENT_WEB_APPLICANT_RECOMMENDED_VERSION=1.0.0
TAXIMOBILE_CLIENT_WEB_OPERATIONS_MINIMUM_VERSION=1.0.0
TAXIMOBILE_CLIENT_WEB_OPERATIONS_RECOMMENDED_VERSION=1.0.0
# Required only when password-only operations login is disabled. Supply one
# unpadded base64url-encoded 32-byte key through the deployment secret boundary.
TAXIMOBILE_OPERATIONS_MFA_ENCRYPTION_KEY=
TAXIMOBILE_OPERATIONS_SECURE_COOKIE_ENABLED=false
# Transitional global /admin routes. Local compatibility only; staging and
# production reject true and expose only scoped /operations administration.
TAXIMOBILE_LEGACY_ADMIN_API_ENABLED=true
TAXIMOBILE_MATCHING_RADIUS_METERS=3000
TAXIMOBILE_SCHEDULING_POLL_SECONDS=15
TAXIMOBILE_ANALYTICS_POLL_SECONDS=300
# Durable overdue support/safety discovery. An empty pager pair keeps alerts in
# PostgreSQL and the operations console without claiming external delivery.
TAXIMOBILE_CASE_ALERT_POLL_SECONDS=60
TAXIMOBILE_CASE_ALERT_MAX_DELIVERY_ATTEMPTS=8
TAXIMOBILE_CASE_PAGER_URL=
TAXIMOBILE_CASE_PAGER_TOKEN=
TAXIMOBILE_CASE_PAGER_TIMEOUT_SECONDS=5
TAXIMOBILE_CASE_RETENTION_POLL_SECONDS=3600
TAXIMOBILE_CASE_RETENTION_BATCH_SIZE=100
# Protected driver-document storage is disabled unless root, key, and scanner
# host are all set. For the Docker profile, use the private values shown below
# and generate an independent base64url 32-byte key; never reuse another secret.
TAXIMOBILE_DRIVER_DOCUMENT_STORAGE_ROOT=
TAXIMOBILE_DRIVER_DOCUMENT_ENCRYPTION_KEY=
TAXIMOBILE_DRIVER_DOCUMENT_CLAMAV_HOST=
TAXIMOBILE_DRIVER_DOCUMENT_CLAMAV_PORT=3310
TAXIMOBILE_DRIVER_DOCUMENT_CLAMAV_TIMEOUT_SECONDS=10
TAXIMOBILE_DRIVER_DOCUMENT_MAX_BYTES=10485760
TAXIMOBILE_DRIVER_DOCUMENT_RETENTION_DAYS=730
TAXIMOBILE_DRIVER_DOCUMENT_RETENTION_POLL_SECONDS=3600
TAXIMOBILE_DRIVER_DOCUMENT_RETENTION_BATCH_SIZE=100
TAXIMOBILE_DRIVER_DOCUMENT_UPLOAD_RATE_LIMIT_PER_HOUR=20
TAXIMOBILE_DRIVER_DOCUMENT_ACCESS_RATE_LIMIT_PER_MINUTE=30
TAXIMOBILE_MATCHING_LOCATION_FRESHNESS_SECONDS=30
TAXIMOBILE_MATCHING_CANDIDATE_LIMIT=10
TAXIMOBILE_MATCHING_IDLE_CAP_SECONDS=1800
TAXIMOBILE_MATCHING_FAIRNESS_LOOKBACK_HOURS=24
TAXIMOBILE_MATCHING_ASSUMED_PICKUP_SPEED_MPS=6.944
TAXIMOBILE_MATCHING_PROXIMITY_WEIGHT=0.55
TAXIMOBILE_MATCHING_IDLE_WEIGHT=0.30
TAXIMOBILE_MATCHING_FAIRNESS_WEIGHT=0.15
TAXIMOBILE_MATCHING_ALGORITHM_VERSION=mvp-v1
TAXIMOBILE_MATCHING_POLL_SECONDS=1
TAXIMOBILE_CREDENTIAL_POLL_SECONDS=60
TAXIMOBILE_CREDENTIAL_EXPIRY_WARNING_DAYS=30
TAXIMOBILE_MATCHING_TIMEOUT_SECONDS=300
TAXIMOBILE_RIDE_OFFER_SECONDS=45
TAXIMOBILE_ROUTING_PROVIDER=valhalla
TAXIMOBILE_ROUTING_BASE_URL=http://valhalla:8002
TAXIMOBILE_ROUTING_TIMEOUT_SECONDS=5
TAXIMOBILE_ROUTING_RATE_LIMIT_PER_MINUTE=30
# Place discovery fails closed until an approved deployment is selected. For
# staging/production use an HTTPS self-hosted or contractually approved endpoint;
# the shared public Nominatim host is rejected there.
TAXIMOBILE_GEOCODING_PROVIDER=disabled
TAXIMOBILE_GEOCODING_BASE_URL=
TAXIMOBILE_GEOCODING_TIMEOUT_SECONDS=5
TAXIMOBILE_GEOCODING_USER_AGENT=TaxiMobile/0.1 (https://github.com/Q-SiO2/taxi)
TAXIMOBILE_PLACE_SEARCH_RATE_LIMIT_PER_MINUTE=20
TAXIMOBILE_PLACE_REVERSE_RATE_LIMIT_PER_MINUTE=30
# Used only by an explicit local routing selection; inputs must remain dated and immutable.
VALHALLA_TILE_URL=https://download.geofabrik.de/africa/morocco-260819.osm.pbf
VALHALLA_SERVER_THREADS=2
# GraphHopper verifies this exact dated extract before building its digest-namespaced graph.
GRAPHHOPPER_OSM_URL=https://download.geofabrik.de/africa/morocco-260819.osm.pbf
GRAPHHOPPER_OSM_SHA256=65bce3352be7444193110ef5f6ae03746a715f843ac8cb215416f637c08b0028
# Leave empty for WebSocket-only local development. Production uses ADC/workload identity.
TAXIMOBILE_FIREBASE_PROJECT_ID=
TAXIMOBILE_FCM_TIMEOUT_SECONDS=5
# Optional zero-integration-cost online payment path. Keep disabled until the
# recipient and at least one bank account or M-Wallet identifier are verified.
TAXIMOBILE_MANUAL_TRANSFER_ENABLED=false
TAXIMOBILE_TRANSFER_RECIPIENT_NAME=
TAXIMOBILE_TRANSFER_BANK_ACCOUNT=
TAXIMOBILE_TRANSFER_WALLET_ID=
# Dedicated 32+ character bearer token for the private per-instance metrics scrape.
TAXIMOBILE_MONITORING_TOKEN=
TAXIMOBILE_OUTBOX_POLL_SECONDS=1
TAXIMOBILE_OUTBOX_MAX_ATTEMPTS=8
# Abuse protections; tune staging/production values without changing source.
TAXIMOBILE_REGISTRATION_RATE_LIMIT_PER_MINUTE=5
TAXIMOBILE_LOGIN_RATE_LIMIT_PER_MINUTE=5
TAXIMOBILE_ACCOUNT_RECOVERY_RATE_LIMIT_PER_HOUR=5
TAXIMOBILE_ACCOUNT_SECURITY_RATE_LIMIT_PER_HOUR=10
TAXIMOBILE_RIDE_CREATION_RATE_LIMIT_PER_MINUTE=5
TAXIMOBILE_RIDE_MESSAGE_RATE_LIMIT_PER_MINUTE=12
TAXIMOBILE_SUPPORT_TICKET_RATE_LIMIT_PER_MINUTE=5
TAXIMOBILE_LOCATION_UPDATE_RATE_LIMIT_PER_MINUTE=60
TAXIMOBILE_VERIFICATION_SUBMISSION_RATE_LIMIT_PER_HOUR=5
TAXIMOBILE_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated browser origins. Leave empty for native-mobile-only local development.
TAXIMOBILE_CORS_ORIGINS=
# Local/test operations console only. Production rejects password-only operations login.
TAXIMOBILE_OPERATIONS_PASSWORD_LOGIN_ENABLED=true
